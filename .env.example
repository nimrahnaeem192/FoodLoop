# Application
NODE_ENV=development

# Frontend
FRONTEND_PORT=3000
VITE_API_BASE_URL=http://localhost:8080

# API Gateway
GATEWAY_PORT=8080

# Auth Service
AUTH_SERVICE_PORT=3001
AUTH_SERVICE_URL=http://localhost:3001

# Core Service
CORE_SERVICE_PORT=3002
CORE_SERVICE_URL=http://localhost:3002

# AI Service (Node) — Gemini keys stay server-side only
AI_SERVICE_PORT=3003
AI_SERVICE_URL=http://localhost:3003
GEMINI_API_KEY_PRIMARY=
GEMINI_API_KEY_BACKUP=
GEMINI_MODEL=gemini-1.5-flash

# Python Matching Service
PYTHON_SERVICE_PORT=8000
PYTHON_SERVICE_URL=http://localhost:8000

# MongoDB
MONGODB_URI=mongodb://localhost:27017/foodloop
MONGO_PORT=27017

# JWT (Auth Service) — never commit real secrets
JWT_SECRET=change-me-in-local-env
JWT_EXPIRES_IN=1d
